# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/kajai_dev"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:4000"

# ─── OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign-In – developer.apple.com → Certificates, Identifiers & Profiles
# APPLE_ID=""          — Services ID (pl. "com.kajai.app")
# APPLE_TEAM_ID=""     — 10 karakteres Team ID
# APPLE_KEY_ID=""      — 10 karakteres Key ID (AuthKey_XXXXXXXX.p8)
# APPLE_PRIVATE_KEY="" — a .p8 fájl tartalma (sortörések \\n-ként)
# APPLE_SECRET generálása: openssl + jose CLI, ld. scripts/generate-apple-secret.md
NEXT_PUBLIC_APPLE_ENABLED="false"

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Meilisearch ─────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_ADMIN_KEY=""

# ─── Storage (Cloudflare R2 / S3) ────────────────────────────
# Cloudflare R2 / S3-compatible object storage
S3_ENDPOINT="https://e4f33a741b60e98901bf03867d2ee26e.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="kajai-dev-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public read URL: custom domain vagy ideiglenes r2.dev URL
S3_PUBLIC_BASE_URL="https://pub-91ce0923067346d0b5a60b82b629308b.r2.dev"

# Food image upload settings
S3_FOOD_IMAGE_PREFIX="foods/basic"
S3_MAX_FILE_SIZE_BYTES="5242880"

# ─── API ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4001"
API_PORT=4001
