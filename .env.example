# ════════════════════════════════════════════════════════════════
#  KajAI – környezeti változók
# ════════════════════════════════════════════════════════════════
#
# Helyi fejlesztéshez két másolat kell (mindkettő gitignorált, SOHA ne commitold):
#   cp .env.example .env.local            # gyökér: API, Prisma, Docker Compose
#   cp .env.example apps/web/.env.local   # a Next.js csak ezt olvassa
# A Prisma parancsok (pnpm db:*) a gyökér .env fájlt olvassák: cp .env.local .env
#
# Jelölés:  [api] NestJS  ·  [web] Next.js  ·  [db] Prisma  ·  [tervezett] a kód még nem használja
# Éles / staging értékek: GitHub Secrets, Railway és Vercel változók – ld. docs/DEPLOYMENT.md

# ─── Adatbázis ───────────────────────────────────────────────
# [api][web][db] PostgreSQL kapcsolat. A csapat a közös Neon dev adatbázist használja
# (a pontos értéket a csapattól kérd el); Docker Compose-zal helyi Postgres is indítható:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kajai_dev"

# ─── Autentikáció (NextAuth) ─────────────────────────────────
# [web][api] A session süti titkosítókulcsa – a webnek és az API-nak UGYANAZ kell legyen.
# Generálás: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
# [web][api] A web publikus címe; az API ezt engedi CORS-ban.
NEXTAUTH_URL="http://localhost:4000"

# [api] Az API által kiadott JWT-k aláíró kulcsa. Generálás: openssl rand -base64 32
JWT_SECRET="change-me-in-production"

# ─── Google OAuth ────────────────────────────────────────────
# [web] console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Engedélyezett redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Apple Sign-In (opcionális) ──────────────────────────────
# [web] developer.apple.com → Certificates, Identifiers & Profiles
# APPLE_ID=""          — Services ID (pl. "com.kajai.app")
# APPLE_TEAM_ID=""     — 10 karakteres Team ID
# APPLE_KEY_ID=""      — 10 karakteres Key ID (AuthKey_XXXXXXXX.p8)
# APPLE_PRIVATE_KEY="" — a .p8 fájl tartalma (sortörések \\n-ként)
# APPLE_SECRET=""      — előre generált client secret (openssl + jose CLI)
NEXT_PUBLIC_APPLE_ENABLED="false"

# ─── E-mail küldés (regisztráció, jelszó-visszaállítás) ──────
# [api] SMTP szerver. Helyi teszthez ingyenes fiók: https://ethereal.email
MAIL_HOST="smtp.ethereal.email"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""

# ─── API ─────────────────────────────────────────────────────
# [api] Az API portja.
API_PORT=4001
# [web] Az API címe a böngésző felől. NEXT_PUBLIC_ → build közben a kliens kódba kerül.
NEXT_PUBLIC_API_URL="http://localhost:4001"

# ─── Redis ───────────────────────────────────────────────────
# [tervezett] Cache és BullMQ queue. Docker Compose: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ─── Meilisearch ─────────────────────────────────────────────
# [tervezett] Teljes szöveges keresés. Docker Compose a MEILISEARCH_ADMIN_KEY-t használja master kulcsként.
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_ADMIN_KEY="kajai-dev-master-key"

# ─── OpenAI ──────────────────────────────────────────────────
# [tervezett] AI dietetikus, OCR.
OPENAI_API_KEY=""

# ─── Tárhely (Cloudflare R2 / S3) ────────────────────────────
# [tervezett] Képfeltöltés (KAI-79).
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="kajai-assets"
STORAGE_PUBLIC_URL=""
