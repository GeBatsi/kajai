{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "FOOD_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "cache": false
    },
    "migrate:dev": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    }
  }
}
