{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "dom"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*",
    "tailwind-preset.ts",
    "tailwind.config.ts",
    ".storybook/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
